{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbx.local/schemas/plugin-automation-v1.json",
  "title": "DBX Community Plugin CLI Automation Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "plugin_version",
    "rpc_tools"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin_id": {
      "$ref": "#/$defs/identifier"
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1,
      "description": "Semver requirement binding this mapping to compatible installed plugin versions."
    },
    "rpc_tools": {
      "$ref": "#/$defs/rpcToolMap"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "rpcToolMap": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rpcTool"
      }
    },
    "rpcTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "description",
        "input_schema",
        "access"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "input_schema": {
          "type": "object"
        },
        "access": {
          "enum": [
            "read",
            "write",
            "full"
          ]
        },
        "connection": {
          "enum": [
            "none",
            "id",
            "lifecycle",
            "both"
          ],
          "default": "id"
        },
        "snapshot": {
          "$ref": "#/$defs/rpcSnapshot"
        }
      }
    },
    "rpcSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_method",
        "stop_method"
      ],
      "properties": {
        "event_method": {
          "type": "string",
          "minLength": 1
        },
        "stop_method": {
          "type": "string",
          "minLength": 1
        },
        "closed_event_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_connection_field": {
          "type": "string",
          "default": "connectionId"
        },
        "event_feed_field": {
          "type": "string",
          "default": "feedId"
        },
        "feed_id_field": {
          "type": "string",
          "default": "feedId"
        },
        "stop_feed_field": {
          "type": "string",
          "default": "feedId"
        },
        "duration_param": {
          "type": "string",
          "default": "durationMs"
        },
        "max_messages_param": {
          "type": "string",
          "default": "maxMessages"
        },
        "default_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "default_max_messages": {
          "type": "integer",
          "minimum": 1
        },
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  }
}
